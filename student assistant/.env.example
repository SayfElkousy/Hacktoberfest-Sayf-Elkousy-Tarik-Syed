# Ollama runs on this laptop and is only ever called by the app's server.
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b

# Port students connect to over HTTPS.
PORT=8443

# Shared secret the teacher dashboard sends as "Authorization: Bearer <token>".
# Left blank, the server generates one on first start and saves it to data/dashboard-token.txt.
DASHBOARD_TOKEN=

# Where the teacher dashboard lives. Set this and a student's join code is looked
# up there. Leave it blank if the dashboard sends procedures to this server instead.
# See docs/DASHBOARD_API.md.
DASHBOARD_URL=

# Sent as "Authorization: Bearer <key>" when calling the dashboard, if it needs one.
DASHBOARD_KEY=

# Where to look up a code, and where to send progress. {code} is replaced with the
# join code. Leave the progress path empty to stop sending progress.
DASHBOARD_LAB_PATH=/api/labs/{code}
DASHBOARD_PROGRESS_PATH=/api/labs/{code}/progress
